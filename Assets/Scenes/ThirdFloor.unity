  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRIFDialogueSystem
  dialogueTextDisplay: {fileID: 663940491}
  dialogueUIPanel: {fileID: 364202253}
  teleportFadeScript: {fileID: 0}
  audioSource: {fileID: 364202255}
  npcAnimator: {fileID: 0}
  dialogueTransitionDuration: 0.4
  endAnimationStateName: Idle
  endTransitionDuration: 0.3
  onDialogueSequenceEnded:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1801739082}
        m_TargetAssemblyTypeName: BedTransitionSequence, Assembly-CSharp
        m_MethodName: ResumeSequence
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 1801739087}
        m_TargetAssemblyTypeName: SmoothDoorTrigger, Assembly-CSharp
        m_MethodName: ActivateReturnRoute
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  autoTeleportOnEnd: 1
  typeSpeed: 0.08
  delayBetweenSentences: 2
  dialogueLines:
  - sentence: 'Setelah operasi, Anda akan dirawat di ICU untuk pemantauan intensif.
      Saat ini akan terpasang alat bantu napas, infus, kateter, dan monitor jantung. '
    dialogueAudio: {fileID: 8300000, guid: 5a0fb1ae52d493944b468778e782c757, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 0
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - sentence: 'Meskipun mungkin terlihat banyak, alat-alat tersebut merupakan bagian
      normal dari perawatan setelah operasi dan berfungsi untuk membantu pemulihan
      anda. '
    dialogueAudio: {fileID: 8300000, guid: 39d56c1c483863245bd37ba1c6999366, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 0
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Tim medis akan selalu memantau dan mendampingi anda selama proses ini.
      Fisioterapis juga akan membantu latihan mobilisasi secara bertahap
    dialogueAudio: {fileID: 8300000, guid: 2a5845b1f38cfe94fa3f5da86b1e5f5b, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 0
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
