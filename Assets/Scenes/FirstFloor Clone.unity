  npcAnimator: {fileID: 0}
  dialogueTransitionDuration: 0.4
  endAnimationStateName: Idle
  endTransitionDuration: 0.3
  autoTeleportOnEnd: 0
  typeSpeed: 0.065
  delayBetweenSentences: 2
  dialogueLines:
  - sentence: Anda akan dikonsulkan ke dr. Deddy Terjasukmana B, Sp.KFR(K), MARS,
      MM, dan fisioterapis
    dialogueAudio: {fileID: 8300000, guid: 37291c8256bdea44fb501a225c8c6fcb, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 1
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Selama disini anda akan mendapatkan edukasi praoperasi meliputi latihan
      rentang gerak bahu, ankle pumping, latihan pernapasan diafragma, latihan duduk
      dengan sternal precaution, serta latihan pernapasan menggunakan incentive spirometry
    dialogueAudio: {fileID: 8300000, guid: 51d9bdef56bb02c4183cac101be9695e, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 1
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Setelah Semua pemeriksaan dilalui dan dokter menyatakan siap untuk
      operasi maka anda akan kami jadwalkan untuk tindakan operasi dan akan diberikan
      surat pengantar rawat
    dialogueAudio: {fileID: 8300000, guid: ad46db5d979d5374684ac6acb2d4e4ac, type: 3}
    animationStateName: 
    waitForButtonPress: 0
    hideMainPanelDuringWait: 1
    onLineStarted:
      m_PersistentCalls:
        m_Calls: []
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 978858329}
